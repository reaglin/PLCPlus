<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Learning.Reports.Pdf</RootNamespace>
  </PropertyGroup>

  <!-- The report renderer (spec 9, "Reports.Pdf"): draws a ProgressSnapshot as a tagged PDF/A. Subject-neutral, like Learning.Core.
       PDFsharp (MIT) is what the family's programs use for PDF (SMADA chose it over QuestPDF for its licence); QRCoder (MIT) as
       PunchMonkeyServer. -->
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp 6.2.4 brings System.Security.Cryptography.Pkcs 8.0.1, which has known advisories (NU1902/NU1903); this lifts it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Learning.Core\Learning.Core.csproj" />
  </ItemGroup>

</Project>
