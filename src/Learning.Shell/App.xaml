<Application x:Class="Learning.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Colours as resources, so a high-contrast theme can replace them later (checklist). -->
        <SolidColorBrush x:Key="PageBrush" Color="#F7F8FA" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#1B2430" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#4A5563" />
        <SolidColorBrush x:Key="LineBrush" Color="#C9D0D9" />
        <SolidColorBrush x:Key="AccentBrush" Color="#B4531A" />
        <SolidColorBrush x:Key="PowerOnBrush" Color="#1E7B34" />
        <SolidColorBrush x:Key="PowerOffBrush" Color="#6B7685" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Lead" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        </Style>
    </Application.Resources>
</Application>
