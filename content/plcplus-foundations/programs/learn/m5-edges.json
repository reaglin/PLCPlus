{
  "schemaVersion": 1,
  "name": "Rising and falling edges",
  "dialect": "iec61131-3",
  "scanTimeMs": 10,
  "tags": [
    {
      "name": "Button",
      "type": "BOOL",
      "io": "input",
      "comment": "a push button"
    },
    {
      "name": "RisePulse",
      "type": "BOOL",
      "comment": "TRUE for one scan when Button is pressed"
    },
    {
      "name": "FallPulse",
      "type": "BOOL",
      "comment": "TRUE for one scan when Button is let go"
    },
    {
      "name": "Held",
      "type": "BOOL",
      "io": "output",
      "comment": "on for as long as Button is held"
    }
  ],
  "programs": [
    {
      "name": "Main",
      "rungs": [
        {
          "comment": "Rising edge: passes power for one scan when Button turns TRUE.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "Button",
                "contact": "positiveEdge"
              },
              {
                "kind": "coil",
                "tag": "RisePulse",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "Falling edge: passes power for one scan when Button turns FALSE.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "Button",
                "contact": "negativeEdge"
              },
              {
                "kind": "coil",
                "tag": "FallPulse",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "A plain contact, for comparison: passes power every scan Button is held.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "Button",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
                "tag": "Held",
                "coil": "normal"
              }
            ]
          }
        }
      ]
    }
  ]
}
