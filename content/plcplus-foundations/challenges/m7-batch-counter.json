{
  "schemaVersion": 1,
  "id": "u7.batch-counter",
  "title": "A batch counter",
  "brief": "Each press of Part is one part into the box: count them with an up counter (CTU), and let Reset set the count back to 0. Batch done is lit once the count reaches the batch size dialled on the thumbwheel (BatchSize), and stays lit if more parts come, until Reset. Filling batch is lit while there is at least one part in the box and the batch is not done yet.",
  "scene": "m7-batch-counter",
  "constraints": {
    "maxRungs": 6
  },
  "passThreshold": 1.0,
  "hints": [
    "Rung 1: PartPB into a CTU box (call it C1), with ResetPB in its R. Its count is C1.CV. PV can be any number bigger than a batch, such as 99: the compares do the work.",
    "Batch done: compare the count with the thumbwheel. Which compare is still true when one part too many comes in?",
    "Filling batch needs two compares in series (AND): the count is greater than 0, and the count is less than BatchSize."
  ],
  "scenarios": [
    {
      "name": "Five parts make a batch of 5",
      "points": 1,
      "durationSeconds": 1.4,
      "events": [
        {
          "t": 0.1,
          "operate": "part",
          "active": true
        },
        {
          "t": 0.2,
          "operate": "part",
          "active": false
        },
        {
          "t": 0.3,
          "operate": "part",
          "active": true
        },
        {
          "t": 0.4,
          "operate": "part",
          "active": false
        },
        {
          "t": 0.5,
          "operate": "part",
          "active": true
        },
        {
          "t": 0.6,
          "operate": "part",
          "active": false
        },
        {
          "t": 0.7,
          "operate": "part",
          "active": true
        },
        {
          "t": 0.8,
          "operate": "part",
          "active": false
        },
        {
          "t": 0.9,
          "operate": "part",
          "active": true
        },
        {
          "t": 1.0,
          "operate": "part",
          "active": false
        }
      ],
      "assertions": [
        {
          "at": 0.05,
          "tag": "Filling",
          "expect": "FALSE",
          "says": "With no parts in the box yet, Filling batch should be off."
        },
        {
          "at": 0.75,
          "tag": "Filling",
          "expect": "TRUE",
          "says": "After 4 parts of a batch of 5, Filling batch should be lit."
        },
        {
          "at": 0.75,
          "tag": "BatchDone",
          "expect": "FALSE",
          "says": "After 4 parts of a batch of 5, the batch is not done yet."
        },
        {
          "at": 1.1,
          "tag": "BatchDone",
          "expect": "TRUE",
          "says": "The 5th part makes a batch of 5: Batch done should be lit."
        },
        {
          "at": 1.1,
          "tag": "Filling",
          "expect": "FALSE",
          "says": "Once the batch is done, Filling batch should go out."
        }
      ]
    },
    {
      "name": "One part too many: still done, until Reset",
      "points": 1,
      "durationSeconds": 2.0,
      "events": [
        {
          "t": 0.1,
          "operate": "part",
          "active": true
        },
        {
          "t": 0.2,
          "operate": "part",
          "active": false
