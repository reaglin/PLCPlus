<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A Windows version, so the program can later ask the Microsoft Store for a new version (Windows.Services.Store). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PLCPlus</AssemblyName>
    <RootNamespace>Learning.Shell</RootNamespace>
    <!-- Declares PerMonitorV2; without it the app is not DPI aware and WACK warns. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Images/dr-ron-eaglin.jpg" />
  </ItemGroup>

  <!-- The content packages ship beside the program (spec 6: content is data, not code). -->
  <ItemGroup>
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Learning.Core\Learning.Core.csproj" />
    <ProjectReference Include="..\Plc.Engine\Plc.Engine.csproj" />
    <ProjectReference Include="..\Plc.Dialects.Iec\Plc.Dialects.Iec.csproj" />
    <ProjectReference Include="..\Plc.Scenes\Plc.Scenes.csproj" />
    <ProjectReference Include="..\Plc.Grading\Plc.Grading.csproj" />
    <ProjectReference Include="..\Plc.Editors\Plc.Editors.csproj" />
  </ItemGroup>

</Project>
