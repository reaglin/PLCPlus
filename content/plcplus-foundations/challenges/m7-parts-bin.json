          "tag": "BinEmpty",
          "expect": "FALSE",
          "says": "After Refill there are 10 parts: Bin empty should be off."
        },
        {
          "at": 0.3,
          "tag": "PartsLow",
          "expect": "FALSE",
          "says": "10 parts are plenty: Parts low should be off."
        },
        {
          "at": 1.55,
          "tag": "PartsLow",
          "expect": "FALSE",
          "says": "4 parts left is more than 3: Parts low should still be off."
