{
  "schemaVersion": 1,
  "name": "Run the exhaust fan on after the heater (a common mistake)",
  "dialect": "iec61131-3",
  "scanTimeMs": 10,
  "tags": [
    {
      "name": "HeatSW",
      "type": "BOOL",
      "io": "input",
      "comment": "Heater switch: TRUE in On"
    },
    {
      "name": "PurgePB",
      "type": "BOOL",
      "io": "input",
      "comment": "Purge button: TRUE while pressed"
    },
    {
      "name": "Heater",
      "type": "BOOL",
      "io": "output"
    },
    {
      "name": "Fan",
      "type": "BOOL",
      "io": "output"
    },
    {
      "name": "T1",
      "type": "TOF",
      "comment": "the fan's 5 s run-on"
    },
    {
      "name": "T2",
      "type": "TP",
      "comment": "the 3 s purge"
    }
  ],
  "programs": [
    {
      "name": "Main",
      "rungs": [
        {
          "comment": "The heater follows its switch.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "HeatSW",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
                "tag": "Heater",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "Off-delay: Q is on while the heater is on, and 5 s after.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "Heater",
                "contact": "normallyOpen"
              },
              {
                "kind": "box",
                "instruction": "TOF",
                "instance": "T1",
                "operands": {
                  "PT": "T#5s"
                }
              }
            ]
          }
        },
        {
          "comment": "A pulse timer for the purge...",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "PurgePB",
                "contact": "normallyOpen"
              },
              {
                "kind": "box",
                "instruction": "TP",
                "instance": "T2",
                "operands": {
                  "PT": "T#3s"
                }
              }
            ]
          }
        },
        {
          "comment": "MISTAKE: the fan uses the Purge button itself, not the pulse timer's Q.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "parallel",
                "branches": [
                  {
                    "kind": "series",
                    "items": [
                      {
                        "kind": "contact",
                        "tag": "T1.Q",
                        "contact": "normallyOpen"
                      }
                    ]
                  },
                  {
                    "kind": "series",
                    "items": [
                      {
                        "kind": "contact",
                        "tag": "PurgePB",
                        "contact": "normallyOpen"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "coil",
                "tag": "Fan",
                "coil": "normal"
              }
            ]
          }
        }
      ]
    }
  ]
}
