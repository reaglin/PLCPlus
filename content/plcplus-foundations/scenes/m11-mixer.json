{
  "schemaVersion": 1,
  "id": "m11-mixer",
  "title": "Batch mixer",
  "description": "A batch mixer with a warning horn, a Start button and a Stop button (wired normally closed).",
  "width": 440,
  "height": 300,
  "components": [
    {
      "type": "pushButton",
      "id": "start",
      "label": "Start",
      "tag": "StartPB",
      "color": "green",
      "x": 30,
      "y": 30
    },
    {
      "type": "pushButton",
      "id": "stop",
      "label": "Stop",
      "tag": "StopPB",
      "normallyClosed": true,
      "color": "red",
      "x": 30,
      "y": 150
    },
    {
      "type": "horn",
      "id": "horn",
      "label": "Warning horn",
      "tag": "Horn",
      "x": 190,
      "y": 30
    },
    {
      "type": "motor",
      "id": "mixer",
      "label": "Mixer",
      "runTag": "Mixer",
      "startTimeMs": 1000,
      "x": 280,
      "y": 130
    }
  ]
}
