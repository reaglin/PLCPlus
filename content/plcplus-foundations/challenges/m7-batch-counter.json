        {
          "t": 0.6,
          "operate": "part",
          "active": false
        }
      ],
      "assertions": [
        {
          "at": 0.45,
          "tag": "BatchDone",
          "expect": "FALSE",
          "says": "With the thumbwheel at 3, two parts are not a batch yet."
        },
        {
          "at": 0.75,
          "tag": "BatchDone",
          "expect": "TRUE",
          "says": "With the thumbwheel at 3, the 3rd part should light Batch done. Compare with BatchSize, not a fixed number."
        }
      ]
    },
