{
  "schemaVersion": 1,
  "name": "A doorbell with two buttons (works)",
  "dialect": "iec61131-3",
  "scanTimeMs": 10,
  "tags": [
    {
      "name": "FrontPB",
      "type": "BOOL",
      "io": "input",
      "comment": "Front door button: TRUE while pressed"
    },
    {
      "name": "BackPB",
      "type": "BOOL",
      "io": "input",
      "comment": "Back door button: TRUE while pressed"
    },
    {
      "name": "FrontLight",
      "type": "BOOL",
      "io": "output"
    },
    {
      "name": "BackLight",
      "type": "BOOL",
      "io": "output"
    },
    {
      "name": "Bell",
      "type": "BOOL",
      "io": "output"
    }
  ],
  "programs": [
    {
      "name": "Main",
      "rungs": [
        {
          "comment": "The Front light while the front button is pressed.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "FrontPB",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
                "tag": "FrontLight",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "The Back light while the back button is pressed.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "BackPB",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
                "tag": "BackLight",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "FIXED: one rung rings the bell, with the two buttons side by side (OR). One coil per output.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "parallel",
                "branches": [
                  {
                    "kind": "series",
                    "items": [
                      {
                        "kind": "contact",
                        "tag": "FrontPB",
                        "contact": "normallyOpen"
                      }
                    ]
                  },
                  {
                    "kind": "series",
                    "items": [
                      {
                        "kind": "contact",
                        "tag": "BackPB",
                        "contact": "normallyOpen"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "coil",
                "tag": "Bell",
                "coil": "normal"
              }
            ]
          }
        }
      ]
    }
  ]
}
