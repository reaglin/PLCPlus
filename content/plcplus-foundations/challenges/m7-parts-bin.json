{
  "schemaVersion": 1,
  "id": "u7.parts-low",
  "title": "A parts-low warning",
  "brief": "Refill puts 10 parts in the bin; each press of Part used takes one out. Parts low is lit while there are some parts left but no more than the number on the Warn at thumbwheel. Bin empty is lit when no parts are left (the bin starts empty).",
  "scene": "m7-parts-bin",
  "constraints": {
    "maxRungs": 6
  },
  "passThreshold": 1.0,
  "hints": [
    "A down counter (CTD) keeps the number of parts left: LD (Refill) loads 10, and each Part used counts down one.",
    "Parts low: the count is at most WarnAt (LE) AND more than 0 (GT).",
    "Bin empty: the count is 0 or less (LE 0), which still works if someone presses Part used once too often."
  ],
  "scenarios": [
    {
      "name": "The bin starts empty",
      "points": 1,
      "durationSeconds": 0.3,
      "events": [],
      "assertions": [
        {
          "at": 0.1,
          "tag": "BinEmpty",
          "expect": "TRUE",
          "says": "At power-up there are no parts: Bin empty should be lit."
        }
      ]
    },
    {
      "name": "Parts low at 3 left",
      "points": 1,
      "durationSeconds": 2.2,
      "events": [
        {
          "t": 0.1,
          "operate": "refill",
          "active": true
        },
