<?xml version="1.0" encoding="utf-8"?>

<!-- Identity/Publisher below are the DEVELOPMENT values. pack.ps1 rewrites Version and
     Publisher so the manifest matches the signing certificate; the Store-issued identity
     from Partner Center replaces them at submission (see docs/release/STORE-SUBMISSION.md). -->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="RonEaglin.PLCPlus"
    Publisher="CN=PLCPlus Development"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PLC+</DisplayName>
    <!-- Must match the Partner Center account's publisher display name character for character
         or certification fails. Ron's Microsoft Store account publishes as "Dean Eaglin". -->
    <PublisherDisplayName>Dean Eaglin</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PLCPlus" Executable="PLCPlus.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PLC+"
        Description="Learn PLC programming at home, from electrical basics to ladder logic, with simulated machines in place of real hardware."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="PLC+"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#14324A" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Restricted capability, standard for a desktop app. Needs written justification at
         submission; the wording is in docs/release/STORE-SUBMISSION.md. PLC+ needs nothing else:
         it works offline, and the links it opens go to the web browser. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
