{
  "schemaVersion": 1,
  "name": "A batch counter (a common mistake)",
  "dialect": "iec61131-3",
  "scanTimeMs": 10,
  "tags": [
    {
      "name": "PartPB",
      "type": "BOOL",
      "io": "input",
      "comment": "Part button (stands for the part sensor): TRUE while pressed"
    },
    {
      "name": "ResetPB",
      "type": "BOOL",
      "io": "input",
      "comment": "Reset button: TRUE while pressed"
    },
    {
      "name": "BatchSize",
      "type": "INT",
      "io": "input",
      "comment": "Batch size thumbwheel: 0 to 99"
    },
    {
      "name": "Filling",
      "type": "BOOL",
      "io": "output"
    },
    {
      "name": "BatchDone",
      "type": "BOOL",
      "io": "output"
    },
    {
      "name": "C1",
      "type": "CTU",
      "comment": "counts the parts"
    }
  ],
  "programs": [
    {
      "name": "Main",
      "rungs": [
        {
          "comment": "Count each part. Reset sets the count back to 0.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "PartPB",
                "contact": "normallyOpen"
              },
              {
                "kind": "box",
                "instruction": "CTU",
                "instance": "C1",
                "operands": {
                  "PV": "99",
                  "R": "ResetPB"
                }
              }
            ]
          }
        },
        {
          "comment": "MISTAKE: EQ (EQU) is true only while the count is exactly the batch size. One part more and the light goes out.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "box",
                "instruction": "EQ",
                "operands": {
                  "IN1": "C1.CV",
                  "IN2": "BatchSize"
                }
              },
              {
                "kind": "coil",
                "tag": "BatchDone",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "Filling while 0 < count < batch size.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "box",
                "instruction": "GT",
                "operands": {
                  "IN1": "C1.CV",
                  "IN2": "0"
                }
              },
              {
                "kind": "box",
                "instruction": "LT",
                "operands": {
                  "IN1": "C1.CV",
                  "IN2": "BatchSize"
                }
              },
              {
                "kind": "coil",
                "tag": "Filling",
                "coil": "normal"
              }
            ]
          }
        }
      ]
    }
  ]
}
