{
  "schemaVersion": 1,
  "name": "A limit switch stops the motion",
  "dialect": "iec61131-3",
  "scanTimeMs": 10,
  "tags": [
    {
      "name": "RaisePB",
      "type": "BOOL",
      "io": "input",
      "comment": "hold to raise the barrier arm"
    },
    {
      "name": "TopLimit",
      "type": "BOOL",
      "io": "input",
      "comment": "the limit switch at the top: TRUE when the arm reaches it"
    },
    {
      "name": "ArmUp",
      "type": "BOOL",
      "io": "output",
      "comment": "the motor that raises the arm"
    },
    {
      "name": "AtTop",
      "type": "BOOL",
      "io": "output",
      "comment": "a light: the arm is at the top"
    }
  ],
  "programs": [
    {
      "name": "Main",
      "rungs": [
        {
          "comment": "Raise while RaisePB is held AND the arm is NOT at the top limit.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "RaisePB",
                "contact": "normallyOpen"
              },
              {
                "kind": "contact",
                "tag": "TopLimit",
                "contact": "normallyClosed"
              },
              {
                "kind": "coil",
                "tag": "ArmUp",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "The light shows the limit switch is pressed.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "TopLimit",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
                "tag": "AtTop",
                "coil": "normal"
              }
            ]
          }
        }
      ]
    }
  ]
}
