{
  "schemaVersion": 1,
  "id": "m6-flasher",
  "title": "Alarm beacon",
  "description": "An alarm beacon that flashes while the Alarm switch is on, with a horn that joins in if nobody answers after 3 flashes, and a display of the flashes so far.",
  "width": 440,
  "height": 300,
  "components": [
    {
      "type": "selectorSwitch",
      "id": "alarm",
      "label": "Alarm",
      "tag": "AlarmSW",
      "positions": [
        "Off",
        "On"
      ],
      "x": 30,
      "y": 100
    },
    {
      "type": "pilotLight",
      "id": "beacon",
      "label": "Beacon",
      "tag": "Beacon",
      "color": "amber",
      "x": 200,
      "y": 30
    },
    {
      "type": "horn",
      "id": "horn",
      "label": "Horn",
      "tag": "Horn",
      "x": 320,
      "y": 30
    },
    {
      "type": "numericDisplay",
      "id": "flashes",
      "label": "Flashes",
      "tag": "FlashCount",
      "digits": 2,
      "x": 200,
      "y": 180
    }
  ]
}
