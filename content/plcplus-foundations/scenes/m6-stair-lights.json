    {
      "type": "pushButton",
      "id": "bottom",
      "label": "Bottom of stairs",
      "tag": "StairBottom",
      "color": "green",
      "x": 30,
      "y": 30
    },
    {
      "type": "pushButton",
      "id": "top",
      "label": "Top of stairs",
      "tag": "StairTop",
      "color": "green",
      "x": 30,
      "y": 130
    },
    {
      "type": "selectorSwitch",
      "id": "door",
      "label": "Front door",
      "tag": "DoorOpen",
      "positions": [
        "Shut",
        "Open"
      ],
      "x": 30,
      "y": 230
    },
    {
      "type": "pilotLight",
      "id": "stair",
      "label": "Stair light",
      "tag": "StairLight",
      "color": "amber",
      "x": 260,
      "y": 60
    },
    {
      "type": "pilotLight",
      "id": "porch",
      "label": "Porch light",
      "tag": "PorchLight",
      "color": "amber",
      "x": 260,
      "y": 220
    }
  ]
}
