<Window x:Class="Learning.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Learning.Shell"
        Title="{Binding Title}" Width="1480" Height="920" MinWidth="1100" MinHeight="640"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="ApplicationCommands.Help" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ShowTab}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ShowTab}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ShowTab}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ShowTab}" CommandParameter="3" />
        <KeyBinding Key="PageDown" Modifiers="Ctrl+Shift" Command="{Binding NextCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Ctrl+Shift" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="Home" Modifiers="Ctrl+Shift" Command="{Binding ShowDashboardCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{Binding ShowReportsCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{x:Static local:MainWindow.TextLarger}" />
        <KeyBinding Key="OemPlus" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.TextLarger}" />
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{x:Static local:MainWindow.TextLarger}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{x:Static local:MainWindow.TextSmaller}" />
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{x:Static local:MainWindow.TextSmaller}" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{x:Static local:MainWindow.TextNormal}" />
        <KeyBinding Key="L" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.SwitchLearner}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed" />
        <CommandBinding Command="{x:Static local:MainWindow.ShowTab}" Executed="ShowTab_Executed" CanExecute="ItemShown_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.TextLarger}" Executed="TextSize_Executed" CanExecute="SignedIn_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.TextSmaller}" Executed="TextSize_Executed" CanExecute="SignedIn_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.TextNormal}" Executed="TextSize_Executed" CanExecute="SignedIn_CanExecute" />
        <CommandBinding Command="{x:Static local:MainWindow.SwitchLearner}" Executed="SwitchLearner_Click" CanExecute="SignedIn_CanExecute" />
    </Window.CommandBindings>

    <Grid>
    <DockPanel x:Name="AppContent" KeyboardNavigation.TabNavigation="Local" Visibility="Hidden">
        <!-- Text size (plan 7.7): the whole window scales, so nothing is cut off or overlaps. -->
        <DockPanel.LayoutTransform>
            <ScaleTransform ScaleX="{Binding TextScale}" ScaleY="{Binding TextScale}" />
        </DockPanel.LayoutTransform>
        <!-- The menu row: the menus on the left; who is signed in and their backup on the right. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
        <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="LearnerText" Text="{Binding LearnerName}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"
                       AutomationProperties.Name="{Binding LearnerName, StringFormat='Signed in as {0}'}" />
            <Button x:Name="BackupButton" Click="Backup_Click" Padding="8,2" Margin="0" Content="{Binding BackupText}" ToolTip="{Binding BackupTip}"
                    AutomationProperties.Name="{Binding BackupText}" />
        </StackPanel>
        <Menu Padding="4,2" KeyboardNavigation.TabIndex="0" Background="Transparent">
            <MenuItem Header="_File" SubmenuOpened="FileMenu_Opened">
                <MenuItem x:Name="OpenProgramItem" Header="_Open a program…" Click="OpenProgram_Click"
                          ToolTip="Opens a program saved from PLC+ (.plcprogram) as My program on the Exercise tab" />
                <MenuItem x:Name="SaveProgramItem" Header="_Save My program as…" Click="SaveProgram_Click"
                          ToolTip="Saves My program on the Exercise tab to a file you choose (.plcprogram), to keep, hand in or open on another computer" />
                <MenuItem x:Name="SavePictureItem" Header="Save the program as a _picture…" Click="SavePicture_Click"
                          ToolTip="Saves the rungs on the Example or Exercise tab as a picture (PNG), for a report or a handout" />
                <Separator />
                <MenuItem Header="_Check a report (for instructors)…" Click="CheckReport_Click"
                          ToolTip="For instructors: checks that a PLC+ progress report (PDF) or result line is genuine and was not changed, and makes a class code" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" ToolTip="Closes PLC+. Your progress and My program are saved in your progress file first." />
            </MenuItem>
            <MenuItem Header="_Learner">
                <MenuItem x:Name="BackupItem" Header="_Back up my progress…" Click="Backup_Click"
                          ToolTip="Saves a copy of your progress file on a USB drive or in a cloud folder (OneDrive, Google Drive …), so it is safe if this computer's copy is lost" />
                <MenuItem Header="_Change my PIN…" Click="ChangePin_Click" ToolTip="Choose a new PIN; you need the PIN you use now" />
                <Separator />
                <MenuItem Header="_Switch learner" InputGestureText="Ctrl+Shift+L" Click="SwitchLearner_Click"
                          ToolTip="Saves your work, locks your progress and goes back to the list of learners, for the next person" />
            </MenuItem>
            <MenuItem Header="_Go">
                <MenuItem Header="_My progress" InputGestureText="Ctrl+Shift+Home" Command="{Binding ShowDashboardCommand}"
                          ToolTip="Your progress through the whole path: each module, the module checks, outcomes to review, and your time in PLC+" />
                <MenuItem Header="_Hand in a report" InputGestureText="Ctrl+Shift+R" Command="{Binding ShowReportsCommand}"
                          ToolTip="Make a progress report (a PDF) for a module check, or of everything so far, and hand it in to your instructor" />
                <MenuItem Header="_Continue where I left off" Command="{Binding ContinueWhereILeftOffCommand}"
                          ToolTip="Opens the first item in the path you have not completed yet" />
                <MenuItem Header="_Next item" InputGestureText="Ctrl+Shift+PgDn" Command="{Binding NextCommand}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="The next item in the path (from a module's first page: its first item). Greyed on the last item" />
                <MenuItem Header="_Previous item" InputGestureText="Ctrl+Shift+PgUp" Command="{Binding PreviousCommand}" ToolTipService.ShowOnDisabled="True"
                          ToolTip="The item before this one. Greyed on the first item, or when no item is open" />
                <Separator />
                <MenuItem Header="_Learn tab" InputGestureText="Ctrl+1" Command="{x:Static local:MainWindow.ShowTab}" CommandParameter="0" />
                <MenuItem Header="_Example tab" InputGestureText="Ctrl+2" Command="{x:Static local:MainWindow.ShowTab}" CommandParameter="1" />
                <MenuItem Header="E_xercise tab" InputGestureText="Ctrl+3" Command="{x:Static local:MainWindow.ShowTab}" CommandParameter="2" />
                <MenuItem Header="_Reference tab" InputGestureText="Ctrl+4" Command="{x:Static local:MainWindow.ShowTab}" CommandParameter="3" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Larger text" InputGestureText="Ctrl++" Command="{x:Static local:MainWindow.TextLarger}"
                          ToolTip="Makes everything in the window bigger. Kept for you, in your progress file" />
                <MenuItem Header="_Smaller text" InputGestureText="Ctrl+−" Command="{x:Static local:MainWindow.TextSmaller}" ToolTip="Makes everything in the window smaller" />
                <MenuItem Header="_Normal size" InputGestureText="Ctrl+0" Command="{x:Static local:MainWindow.TextNormal}" ToolTip="Back to the usual size" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help for this screen" InputGestureText="F1" Command="ApplicationCommands.Help"
                          ToolTip="Shows or hides the help panel on the right: what this screen is for and how to use it" />
                <MenuItem Header="Help on the _web (softwareplus.ai/plcplus)" Click="WebHelp_Click"
                          ToolTip="Opens PLC+'s help pages on softwareplus.ai in your web browser" />
                <Separator />
                <MenuItem Header="Check for a _new version…" Click="CheckForUpdate_Click"
                          ToolTip="Says whether a newer version is out. PLC+ is not on the Microsoft Store yet; once it is, this asks the Store and offers to install it" />
                <MenuItem Header="_About PLC+…" Click="About_Click" ToolTip="Who made PLC+, its version, and where to find more" />
            </MenuItem>
        </Menu>
        </DockPanel>
        </Border>

        <!-- Status line: always says what to do next. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Help panel (F1). -->
        <Border x:Name="HelpPanel" DockPanel.Dock="Right" Width="290" KeyboardNavigation.TabIndex="3" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="HelpScreenTitle" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="HelpScreenText" Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="How to use PLC+" Style="{StaticResource PanelTitle}" Margin="0,10,0,6" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}">
                        A preview for review. PLC+ teaches PLC programming in modules, with simulated machines in place of real ones.
                    </TextBlock>
                    <TextBlock Text="The learning path (left)" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        The modules, in order, each with its items. My progress at the top shows the whole path. The mark says how far you have got: ○ not started, ◐ started, ✓ complete; a module can also be ★ mastered (every outcome mastered) or ↺ review suggested. Choose a module to see what it teaches and what to finish first; choose an item to work on it.
                    </TextBlock>
                    <TextBlock Text="An item's four tabs" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Learn: read the lesson. Example: run the working program on its machine, and see a common mistake. Exercise: write your own program and check it, or answer practice questions. Reference: the symbols and rules the item uses, on one page.
                    </TextBlock>
                    <TextBlock Text="Completing an item" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        An item with an exercise is complete when your program passes every test; one with practice questions, when you pass them; any other item, when you press I have read this. A module check is complete when every item it covers is.
                    </TextBlock>
                    <TextBlock Text="Recommended order" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Each module says which modules to finish first. You can open any module at any time; if you start one early, PLC+ notes it.
                    </TextBlock>
                    <TextBlock Text="On a machine" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Hold a push button down to press it (or Tab to it and hold the Space bar). The rungs run live: a part that passes power is green and thick and shows TRUE. Check runs the task's tests much faster than real time.
                    </TextBlock>
                    <TextBlock Text="Your progress" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Kept in your own file, locked with your PIN. Go ▸ My progress (Ctrl+Shift+Home, or the top of the path) shows each module, the module checks, outcomes to review and your time. Back it up (top right) to a USB drive or a cloud folder.
                    </TextBlock>
                    <TextBlock Text="Handing in a report" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        At each module check, make a progress report: Hand in a report (the second row of the path, or Ctrl+Shift+R). PLC+ saves it as a signed PDF; you hand it in the way your instructor asks, usually by uploading it to the assignment. PLC+ never sends anything itself.
                    </TextBlock>
                    <Button Content="Hide help" HorizontalAlignment="Left" Click="Help_Executed" Margin="0,8,0,0"
                            ToolTip="Hides this panel. Press F1 or use Help ▸ Help for this screen to show it again." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PathColumn" Width="300" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="PageColumn" Width="*" MinWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- The learning path -->
            <DockPanel Background="{DynamicResource PanelBrush}" KeyboardNavigation.TabIndex="1">
                <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
                    <TextBlock x:Name="PathTitle" Text="The learning path" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="PathProgress" Text="{Binding TotalsText}" Style="{StaticResource Lead}" Margin="0" Foreground="{DynamicResource InkBrush}"
                               ToolTip="In the modules written so far. Go ▸ My progress has the detail" />
                    <TextBlock x:Name="PathTime" Text="{Binding TimeText}" Style="{StaticResource Lead}" Margin="0,2,0,0" Foreground="{DynamicResource InkBrush}"
                               ToolTip="Time counts while you are using PLC+ (a key or the mouse in the last two minutes), not while it sits idle" />
                    <TextBlock Text="★ mastered · ✓ complete · ↺ review · ◐ started · ○ not started · – coming later" Style="{StaticResource Lead}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TreeView x:Name="PathTree" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent" Padding="4,0,4,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="PathTree_SelectedItemChanged"
                          AutomationProperties.Name="The learning path: modules and their items">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding SpokenName}" />
                            <Setter Property="ToolTip" Value="{Binding Tip}" />
                            <Setter Property="Padding" Value="2,3" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid x:Name="Row">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MarkText" Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontWeight="Bold" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Header}" FontWeight="{Binding Weight}" TextWrapping="Wrap" MaxWidth="215" />
                                    <TextBlock x:Name="DetailText" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="215" />
                                </StackPanel>
                            </Grid>
                            <!-- On the selected row (white on blue), the mark and the detail take the row's colour, so they stay readable. -->
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                    <Setter TargetName="MarkText" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
                                    <Setter TargetName="DetailText" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}" Focusable="False"
                          ToolTip="Drag to make the learning path wider or narrower" />

            <!-- My progress (plan 7.2–7.5) -->
            <DockPanel x:Name="DashboardPage" Grid.Column="2" Margin="18,12,16,10" KeyboardNavigation.TabIndex="2" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="DashboardTitle" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Lead}" Text="Your progress through the whole path. Choose a module on the left to work on it, or press the button to carry on." />
                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="DashboardContinueButton" Command="{Binding ContinueWhereILeftOffCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="Opens the first item in the path you have not completed yet" />
                    </WrapPanel>
                </StackPanel>
                <local:MarkdownView x:Name="DashboardView" AutomationProperties.Name="My progress: your totals, what to review, the module checks, the path and your outcomes" />
            </DockPanel>

            <!-- Hand in a report (plan 8.2–8.7) -->
            <DockPanel x:Name="ReportsPage" Grid.Column="2" Margin="18,12,16,10" KeyboardNavigation.TabIndex="2" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="ReportsTitle" Text="Hand in a progress report" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Lead}" Text="PLC+ makes your report as a PDF: your name, your scores, the tests, your outcomes and your programs. It is signed (a hidden seal shows it was not changed afterwards). You save it, and hand in that file the way your instructor asks (usually by uploading it to an assignment). PLC+ never sends anything itself." />
                </StackPanel>
                <local:ReportsView x:Name="ReportsPanel" />
            </DockPanel>

            <!-- A module's first page -->
            <DockPanel x:Name="ModulePage" Grid.Column="2" Margin="18,12,16,10" KeyboardNavigation.TabIndex="2" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="ModuleTitle" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModuleStatusText" Style="{StaticResource Lead}" />
                    <TextBlock x:Name="ModuleEarlyText" Style="{StaticResource Lead}" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="ModuleStartButton" Click="ModuleStart_Click" />
                    </WrapPanel>
                </StackPanel>
                <local:MarkdownView x:Name="ModuleView" AutomationProperties.Name="What this module teaches" />
            </DockPanel>

            <!-- An item: Learn, Example, Exercise, Reference -->
            <DockPanel x:Name="ItemPage" Grid.Column="2" Margin="18,10,16,10" KeyboardNavigation.TabIndex="2" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top">
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                        <Button x:Name="HandInButton" Content="Hand in a _report…" Click="HandIn_Click" Visibility="Collapsed"
                                ToolTip="Make a progress report for this module check, to hand in to your instructor (you can make one before the check is complete: it is marked Incomplete)" />
                        <Button x:Name="PreviousButton" Content="◂ Previous" Command="{Binding PreviousCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="The item before this one (Ctrl+Shift+PgUp)" />
                        <Button x:Name="NextButton" Content="Next ▸" Command="{Binding NextCommand}" ToolTipService.ShowOnDisabled="True" Margin="0" ToolTip="The next item in the path (Ctrl+Shift+PgDn)" />
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock x:Name="ItemModuleText" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="ItemTitle" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap" />
                        <TextBlock x:Name="ItemStatusText" Style="{StaticResource Lead}" Margin="0,0,0,2" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </DockPanel>
                <TabControl x:Name="ItemTabs" Margin="0,6,0,0" SelectionChanged="ItemTabs_SelectionChanged">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="16,5" />
                            <Setter Property="FontSize" Value="15" />
                        </Style>
                    </TabControl.Resources>
                    <TabItem x:Name="LearnTab" Header="_Learn" ToolTip="Read the lesson (Ctrl+1)">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                                <DockPanel>
                                    <Button x:Name="ReadButton" DockPanel.Dock="Left" Content="I have _read this" Click="Read_Click"
                                            ToolTip="Marks this item complete. Items without an exercise are complete when you have read them." />
                                    <TextBlock x:Name="LearnFooterText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                                </DockPanel>
                            </Border>
                            <local:MarkdownView x:Name="LearnView" AutomationProperties.Name="The lesson" />
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="ExampleTab" Header="Exa_mple" ToolTip="Run the working program on its machine (Ctrl+2)">
                        <Grid Margin="8,0,8,8">
                            <ScrollViewer x:Name="ExampleScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" SizeChanged="MachineScroll_SizeChanged">
                                <local:MachineWorkspace x:Name="ExampleWorkspace" />
                            </ScrollViewer>
                            <TextBlock x:Name="ExampleNone" Style="{StaticResource Lead}" Margin="4,12" Visibility="Collapsed" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ExerciseTab" Header="Exerc_ise" ToolTip="Write your own program and check it (Ctrl+3)">
                        <Grid Margin="8,0,8,8">
                            <ScrollViewer x:Name="ExerciseScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" SizeChanged="MachineScroll_SizeChanged">
                                <local:MachineWorkspace x:Name="ExerciseWorkspace" />
                            </ScrollViewer>
                            <local:MarkdownView x:Name="ExerciseNone" Visibility="Collapsed" AutomationProperties.Name="About this item's exercise" />
                            <ScrollViewer x:Name="QuizScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <local:QuizView x:Name="QuizPanel" AutomationProperties.Name="Questions" />
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="ReferenceTab" Header="Refere_nce" ToolTip="The symbols and rules this item uses (Ctrl+4)">
                        <local:MarkdownView x:Name="ReferenceView" AutomationProperties.Name="Reference" />
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
    <!-- Nobody signed in: the start screen covers everything (plan 6.1). -->
    <local:LearnerScreen x:Name="SignInScreen" />
    </Grid>
</Window>
