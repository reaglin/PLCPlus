{
  "schemaVersion": 1,
  "name": "Start and stop a pump (a common mistake)",
  "dialect": "iec61131-3",
  "scanTimeMs": 10,
  "tags": [
    {
      "name": "PumpStart",
      "type": "BOOL",
      "io": "input",
      "comment": "Start button (normally open): TRUE while pressed"
    },
    {
      "name": "PumpStop",
      "type": "BOOL",
      "io": "input",
      "comment": "Stop button (normally closed): TRUE while NOT pressed"
    },
    {
      "name": "OverloadOK",
      "type": "BOOL",
      "io": "input",
      "comment": "Overload relay contact (normally closed): TRUE while it has NOT tripped"
    },
    {
      "name": "Pump",
      "type": "BOOL",
      "io": "output"
    },
    {
      "name": "PumpLight",
      "type": "BOOL",
      "io": "output"
    }
  ],
  "programs": [
    {
      "name": "Main",
      "rungs": [
        {
          "comment": "MISTAKE: Stop is checked with a normally closed contact. Stop is wired normally closed, so its input is TRUE while nobody presses it, and this contact never passes power.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "parallel",
                "branches": [
                  {
                    "kind": "series",
                    "items": [
                      {
                        "kind": "contact",
                        "tag": "PumpStart",
                        "contact": "normallyOpen"
                      }
                    ]
                  },
                  {
                    "kind": "series",
                    "items": [
                      {
                        "kind": "contact",
                        "tag": "Pump",
                        "contact": "normallyOpen"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "contact",
                "tag": "PumpStop",
                "contact": "normallyClosed"
              },
              {
                "kind": "contact",
                "tag": "OverloadOK",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
                "tag": "Pump",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "The light follows the pump.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "Pump",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
                "tag": "PumpLight",
                "coil": "normal"
              }
            ]
          }
        }
      ]
    }
  ]
}
