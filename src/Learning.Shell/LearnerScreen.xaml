<UserControl x:Class="Learning.Shell.LearnerScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}">
    <!-- The start screen (plan 6.1): every learner on this computer; choose your name, type your PIN, press Open.
         Plan W.5 (Ron, 2026-11-23; WebDevelopment+ 13.9): four sections, each with its own light colour and border: Who is learning?, Course Tools
         (no login required) and Learner files fold; Help and information (with About PlusBooks) stays open at the bottom. -->
    <DockPanel>
        <Border DockPanel.Dock="Right" Width="320" Background="{DynamicResource HelpPanelBrush}" BorderBrush="{DynamicResource HelpBarLineBrush}"
                BorderThickness="1,0,0,0" Padding="18,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="This screen: who is learning?" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}"
                               Text="Each learner's progress is kept in a file of their own, locked with their PIN. Open Who is learning? (green), choose your name, type your PIN and press Open. New here? Open it and press New learner." />
                    <TextBlock Text="The four sections" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}"
                               Text="Who is learning? (green) is where you sign in. Course Tools (amber) work without signing in. Learner files (lavender) bring a progress file in, take one off this computer, and say where the files are kept. Help and information (blue) is at the bottom. The sections start folded so you can see them all; choose a section's name, or the arrow beside it, to open or fold it." />
                    <TextBlock Text="Instructors" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}"
                               Text="Check a report (in Course Tools) checks a student's PDF report without signing in. To try PLC+ yourself, press New learner with any name and PIN; Remove (in Learner files) takes it off again. Reviewing PLC+? Testing guide (in Help and information) says what to try and how to send your notes." />
                    <TextBlock Text="Your PIN" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}"
                               Text="4 to 6 digits that you chose. After 5 wrong tries PLC+ makes you wait a little before the next, and the wait grows. Forgot it? Choose your name and press Forgot my PIN: your recovery code sets a new one." />
                    <TextBlock Text="Back up your progress" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}"
                               Text="Lab computers can be changed or replaced, so keep a copy of your file on a USB drive or in a cloud folder (Learner ▸ Back up my progress, once you are in). The list shows when each learner last did. On another computer, Add learner from file brings your progress in; if you are already there, the two copies are combined and nothing is lost." />
                    <TextBlock Text="What the PIN protects" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}"
                               Text="The PIN stops classmates opening each other's progress on a shared computer. It is a short number, so it is a lock for the classroom, not a safe: someone with a copy of your file and time to spare could get in. Keep your backups somewhere only you use." />
                    <TextBlock Text="Leaving" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}"
                               Text="Learner ▸ Switch learner, or closing PLC+, saves your work and locks your file. PLC+ also locks itself after a while without use (15 minutes unless Settings says otherwise)." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel MaxWidth="760" Margin="40,24,40,24" HorizontalAlignment="Left">
                <TextBlock Text="PLC+" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"
                           Text="Learn PLC programming step by step, with simulated machines in place of real hardware. Each person who learns on this computer has a progress file of their own." />
                <!-- Ron, 2026-11-23: the sections start folded, so every option shows at a glance; this line says how to open one. -->
                <TextBlock x:Name="SectionsHint" Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" Margin="0,0,0,12"
                           Text="Choose a section's name (or the arrow beside it) to open it: Who is learning? to sign in or start as a new learner, Course Tools to use the tools without signing in, Learner files for progress files." />

                <!-- Above the sections, so folding one never hides them (UX review 2026-11-23): why the screen is back, and what a button did. -->
                <Border x:Name="LockedBanner" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#9DB4CC" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock x:Name="LockedText" TextWrapping="Wrap" Foreground="#1B2430" AutomationProperties.LiveSetting="Polite" />
                </Border>
                <Border x:Name="MessageBorder" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#D9A3A3" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#A41E1E" AutomationProperties.LiveSetting="Polite" />
                </Border>

                <!-- 1. Who is learning? (light green, like PlusBook Learning in the book's window) -->
                <Border x:Name="WhoSection" Style="{StaticResource SectionBox}" Background="{DynamicResource LearningBrush}" BorderBrush="{DynamicResource LearningLineBrush}">
                    <Border.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource SectionButton}">
                            <Setter Property="BorderBrush" Value="{DynamicResource LearningLineBrush}" />
                        </Style>
                    </Border.Resources>
                    <Expander x:Name="WhoExpander" IsExpanded="False" Expanded="WhoExpander_Expanded" AutomationProperties.Name="Who is learning?"
                              AutomationProperties.HelpText="Sign in: choose your name, type your PIN and press Open; or make a new learner. Space folds or opens this section">
                        <Expander.Header>
                            <TextBlock Text="Who is learning?" Style="{StaticResource SectionHeading}" FontSize="20" AutomationProperties.HeadingLevel="Level2"
                                       ToolTip="Sign in here. The arrow folds or opens this section" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}"
                                       Text="Everyone who learns with PLC+ on this computer is in this list. Your progress, notes and reports are kept in a file of your own, locked with your PIN, so one computer can be shared by a whole class." />

                            <TextBlock x:Name="LeadText" Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold"
                                       Text="Choose your name, type your PIN and press Open." />

                            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,12"
                                       Text="No learners on this computer yet. Press New learner to start. If you have a progress file from another computer or a backup, press Add learner from file." />

                            <ListBox x:Name="LearnersList" MinHeight="60" MaxHeight="360" Margin="0,4,0,10" HorizontalContentAlignment="Stretch"
                                     BorderBrush="{DynamicResource LearningLineBrush}"
                                     AutomationProperties.Name="Learners on this computer" SelectionChanged="LearnersList_SelectionChanged"
                                     MouseDoubleClick="LearnersList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,5" AutomationProperties.Name="{Binding Spoken}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding Backup}" TextWrapping="Wrap" Foreground="{Binding BackupBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <StackPanel x:Name="PinRow" Orientation="Horizontal" Margin="0,0,0,4">
                                <Label x:Name="PinLabel" Content="_PIN:" Target="{Binding ElementName=PinBox}" Padding="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <PasswordBox x:Name="PinBox" Width="140" MaxLength="6" Padding="4,4" VerticalAlignment="Center" BorderBrush="{DynamicResource LearningLineBrush}"
                                             AutomationProperties.Name="PIN" ToolTip="The 4 to 6 digit PIN for the learner chosen above. Press Enter or Open."
                                             PasswordChanged="PinBox_PasswordChanged" />
                                <Button x:Name="OpenButton" Content="_Open" IsDefault="True" Margin="8,0,0,0" Padding="18,5" FontWeight="SemiBold" Click="Open_Click"
                                        ToolTip="Opens the chosen learner's progress with the PIN you typed" />
                            </StackPanel>

                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="_New learner…" Click="New_Click" Margin="0,0,8,4"
                                        ToolTip="Start your own progress file: your name, an optional student ID, and a PIN" />
                                <Button x:Name="ForgotButton" Content="_Forgot my PIN…" Click="Forgot_Click" Margin="0,0,8,4"
                                        ToolTip="Set a new PIN for the learner chosen above, with the recovery code you were given when you started" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 2. Course Tools (light amber): no one signs in. -->
                <Border x:Name="ToolsSection" Style="{StaticResource SectionBox}" Background="{DynamicResource ToolsBrush}" BorderBrush="{DynamicResource ToolsLineBrush}">
                    <Border.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource SectionButton}">
                            <Setter Property="BorderBrush" Value="{DynamicResource ToolsLineBrush}" />
                        </Style>
                    </Border.Resources>
                    <Expander x:Name="ToolsExpander" IsExpanded="False" AutomationProperties.Name="Course Tools (no login required)"
                              AutomationProperties.HelpText="Check a report, without signing in. Space folds or opens this section">
                        <Expander.Header>
                            <TextBlock Text="Course Tools (no login required)" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2"
                                       ToolTip="Tools anyone can use without signing in. The arrow folds or opens this section" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}"
                                       Text="Use these without signing in. Check a report is for instructors: it shows whether a learner's PLC+ progress report is genuine and unchanged, and makes a class code." />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="CheckReportButton" Content="Chec_k a report (for instructors)…" Click="CheckReport_Click" Margin="0,0,8,4"
                                        ToolTip="For instructors: checks that a learner's PLC+ progress report (PDF) or result line is genuine and was not changed, and makes a class code. No learner needs to sign in" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 3. Learner files (light lavender): the progress files themselves. -->
                <Border x:Name="FilesSection" Style="{StaticResource SectionBox}" Background="{DynamicResource FilesBrush}" BorderBrush="{DynamicResource FilesLineBrush}">
                    <Border.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource SectionButton}">
                            <Setter Property="BorderBrush" Value="{DynamicResource FilesLineBrush}" />
                        </Style>
                    </Border.Resources>
                    <Expander x:Name="FilesExpander" IsExpanded="False" AutomationProperties.Name="Learner files"
                              AutomationProperties.HelpText="Bring a progress file in, take a learner off this computer, open the learners' folder, or change where the files are kept. Space folds or opens this section">
                        <Expander.Header>
                            <TextBlock Text="Learner files" Style="{StaticResource SectionHeading}" AutomationProperties.HeadingLevel="Level2"
                                       ToolTip="The learners' progress files. The arrow folds or opens this section" />
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}"
                                       Text="Each learner's progress is one file, locked with their PIN. Bring one in from another computer or a backup (if that learner is already here, the two copies are combined and nothing is lost), take a learner off this computer (first choose their name in Who is learning? above), or choose where the files are kept. Once you are signed in, Learner ▸ Back up my progress copies yours to a USB drive or a cloud folder." />
                            <TextBlock x:Name="FolderText" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="_Add learner from file…" Click="Import_Click" Margin="0,0,8,4"
                                        ToolTip="Bring in a progress file from another computer or a backup. If that learner is already here, the two copies are combined and nothing is lost" />
                                <Button x:Name="RemoveButton" Content="Re_move from this computer…" Click="Remove_Click" Margin="0,0,8,4"
                                        ToolTip="Takes the chosen learner off this computer (needs their PIN; offers a backup first). The file goes to the Recycle Bin" />
                                <Button Content="Open the learners' fo_lder" Click="OpenFolder_Click" Margin="0,0,8,4"
                                        ToolTip="Opens the folder in File Explorer. An instructor can remove the file of a student who has left (the file name is in Remove's tooltip), with PLC+ closed" />
                                <Button Content="_Settings…" Click="Settings_Click" Margin="0,0,8,4"
                                        ToolTip="Where learners' files are kept, and when PLC+ locks itself. For everyone on this computer" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- 4. Help and information (light blue, like help): About PlusBooks, help, the version, About and Exit. -->
                <Border x:Name="InfoSection" Style="{StaticResource SectionBox}" Background="{DynamicResource HelpBarBrush}" BorderBrush="{DynamicResource HelpBarLineBrush}">
                    <Border.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource SectionButton}">
                            <Setter Property="BorderBrush" Value="{DynamicResource HelpBarLineBrush}" />
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <TextBlock Text="Help and information" Style="{StaticResource SectionHeading}" Margin="0,0,0,6" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="About PlusBooks" FontWeight="SemiBold" Margin="0,2,0,2" AutomationProperties.HeadingLevel="Level3" />
                        <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}">
                            PLC+ is a PlusBook: a textbook that is also a program. A PlusBook follows a course topic by topic, with the subject's own tools inside (here, simulated machines and a ladder editor), checks your work as you go, and keeps your progress on your computer, ready to hand in to your instructor as a signed report. More about PlusBooks, and the other books:
                            <Hyperlink x:Name="PlusBooksLink" Click="PlusBooks_Click" ToolTip="Opens the PlusBooks page on softwareplus.ai in your web browser">softwareplus.ai/plusbooks</Hyperlink>
                        </TextBlock>
                        <WrapPanel Margin="0,2,0,0">
                            <Button Content="Help on the _web" Click="WebHelp_Click" Margin="0,0,8,4" ToolTip="Opens PLC+'s help pages on softwareplus.ai in your web browser" />
                            <Button Content="_Testing guide (for instructors)" Click="TestingGuide_Click" Margin="0,0,8,4"
                                    ToolTip="Reviewing PLC+? Opens the testing guide on softwareplus.ai: what to try, and how to send your notes" />
                            <Button Content="Check for a new _version…" Click="CheckForUpdate_Click" Margin="0,0,8,4"
                                    ToolTip="Asks the Microsoft Store whether a newer version of PLC+ is out, and offers to install it" />
                            <Button x:Name="FeedbackButton" Content="Send fee_dback…" Click="SendFeedback_Click" Margin="0,0,8,4"
                                    ToolTip="Tell us about a bug, a suggestion or anything you noticed — it goes to Dr. Ron Eaglin." />
                            <Button Content="A_bout PLC+…" Click="About_Click" Margin="0,0,8,4" ToolTip="Who made PLC+, its version, and where to find more" />
                            <Button Content="E_xit" Click="Exit_Click" Margin="0,0,8,4" ToolTip="Closes PLC+" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
