<Project>

  <!-- Shared settings for PLC+ (src/, tests/, later packaging/). -->

  <PropertyGroup>
    <!-- One version property; the MSIX identity version will be read from it. -->
    <PlcPlusVersion>1.0.0</PlcPlusVersion>
    <Version>$(PlcPlusVersion)</Version>
    <AssemblyVersion>$(PlcPlusVersion).0</AssemblyVersion>
    <FileVersion>$(PlcPlusVersion).0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Ron Eaglin</Company>
    <Product>PLC+</Product>
    <Copyright>Copyright © Ron Eaglin</Copyright>
    <RepositoryUrl>https://github.com/reaglin/PLCPlus</RepositoryUrl>
  </PropertyGroup>

</Project>
