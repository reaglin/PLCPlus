<Window x:Class="Learning.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC Plus — first look at the engine" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="ApplicationCommands.Help" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" Click="Exit_Click" ToolTip="Closes PLC Plus" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help for this screen" InputGestureText="F1" Command="ApplicationCommands.Help"
                          ToolTip="Shows or hides the help panel on the right: what this screen is for and how to use it" />
                <Separator />
                <MenuItem Header="_About PLC Plus…" Click="About_Click" ToolTip="Who made PLC Plus, its version, and where to find more" />
            </MenuItem>
        </Menu>

        <!-- Status line: always says what to do next. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Help panel (F1). -->
        <Border x:Name="HelpPanel" DockPanel.Dock="Right" Width="300" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="How to use this screen" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}">
                        This is an early preview of PLC Plus. It shows the parts that already work: the PLC engine, a simulated machine, and the grader.
                        The lessons, the ladder editor and your saved progress come later.
                    </TextBlock>
                    <TextBlock Text="1. Watch the program run" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        The left side shows the program as ladder rungs. Power flows from the left rail to the right.
                        A part that passes power is drawn green and thick, and shows TRUE; one that does not is grey and thin, and shows FALSE.
                    </TextBlock>
                    <TextBlock Text="2. Work the machine" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Hold down Start (click and hold, or Tab to it and hold the Space bar). The motor starts. Let go: with the seal-in program it keeps running.
                        Press Stop to stop it. The Stop button is wired normally closed, so its input is TRUE until you press it — a broken wire stops the machine, which is safer.
                    </TextBlock>
                    <TextBlock Text="3. Check the program" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Check this program runs the challenge's tests — press buttons at set times and look at the motor — much faster than real time.
                        Choose "Without seal-in" above the rungs to see how a failing test is reported, and the hint you get.
                    </TextBlock>
                    <TextBlock Text="The clock" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        The PLC runs on a simulated clock: every scan moves it on by exactly 10 ms. That is why a program and a test always give the same result.
                        Pause stops the clock; Step runs one scan; Reset starts again from power-up.
                    </TextBlock>
                    <Button Content="Hide help" HorizontalAlignment="Left" Click="Help_Executed" Margin="0,8,0,0"
                            ToolTip="Hides this panel. Press F1 or use Help ▸ Help for this screen to show it again." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                <TextBlock Text="Motor start/stop — a first look" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="BriefText" Style="{StaticResource Lead}" />
            </StackPanel>

            <!-- The program -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="_Program:" Target="{Binding ElementName=ProgramPicker}" Padding="0,0,8,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="ProgramPicker" Width="300" SelectionChanged="ProgramPicker_SelectionChanged"
                                  AutomationProperties.Name="Program"
                                  ToolTip="Which program the PLC runs. Choosing another one resets the PLC and the machine." />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ProgramNote" Style="{StaticResource Lead}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <Canvas x:Name="LadderCanvas" AutomationProperties.Name="Ladder program, live" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- The machine -->
            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12">
                <StackPanel>
                    <TextBlock Text="The machine" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Lead}" Text="Hold a button down to press it; let go to release it." />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                        <Button x:Name="StartButton" Content="_Start" Width="96" Height="56" FontSize="16" FontWeight="SemiBold"
                                Background="#2E8B47" Foreground="White"
                                AutomationProperties.HelpText="Start push button, normally open. Hold it down to press it."
                                ToolTip="Start push button (normally open): its input is TRUE while you hold it down" />
                        <Button x:Name="StopButton" Content="S_top" Width="96" Height="56" FontSize="16" FontWeight="SemiBold"
                                Background="#B3261E" Foreground="White"
                                AutomationProperties.HelpText="Stop push button, normally closed. Hold it down to press it."
                                ToolTip="Stop push button (normally closed): its input is TRUE until you press it" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Ellipse x:Name="LightLamp" Width="28" Height="28" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Margin="0,0,10,0" />
                        <TextBlock x:Name="LightText" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Canvas Width="56" Height="56" Margin="0,0,10,0">
                            <Ellipse Width="56" Height="56" Fill="#DDE3EA" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" />
                            <Rectangle x:Name="MotorShaft" Canvas.Left="25" Canvas.Top="6" Width="6" Height="44" Fill="{DynamicResource InkBrush}"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform x:Name="MotorRotation" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                        <TextBlock x:Name="MotorText" VerticalAlignment="Center" TextWrapping="Wrap" Width="190" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <TextBlock Text="The PLC" Style="{StaticResource PanelTitle}" Margin="0,10,0,4" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock x:Name="ClockText" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button x:Name="PauseButton" Content="_Pause" Click="Pause_Click" Margin="0,0,8,8"
                                ToolTip="Stops the simulated clock. The program and the machine stay as they are." />
                        <Button x:Name="StepButton" Content="Step one sca_n" Click="Step_Click" Margin="0,0,8,8" IsEnabled="False"
                                ToolTip="Runs exactly one scan (10 ms). Available while paused." />
                        <Button Content="_Reset" Click="Reset_Click" Margin="0,0,8,8"
                                ToolTip="Starts again from power-up: every tag off, the motor stopped, the clock at 0." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- The grader -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="230" Margin="0,0,12,0">
                        <Button x:Name="CheckButton" Content="_Check this program" Click="Check_Click" HorizontalAlignment="Left"
                                ToolTip="Runs the challenge's tests on this program, from a clean start each time, and shows which pass" />
                        <TextBlock x:Name="ScoreText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <ItemsControl x:Name="ResultsList" AutomationProperties.Name="Test results" MinHeight="70" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
