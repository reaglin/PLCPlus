<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A Windows version, so the program can later ask the Microsoft Store for a new version (Windows.Services.Store). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PLCPlus</AssemblyName>
    <RootNamespace>Learning.Shell</RootNamespace>
    <!-- Declares PerMonitorV2; without it the app is not DPI aware and WACK warns. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The rung with the "+" as its coil; drawn by packaging/make-store-assets.ps1 (plan 12.1). -->
    <ApplicationIcon>PLCPlus.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Images/dr-ron-eaglin.jpg" />
  </ItemGroup>

  <!-- The content packages ship beside the program (spec 6: content is data, not code). -->
  <ItemGroup>
    <None Include="..\..\content\**\*" LinkBase="content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- MVVM (plan 7.1; Ron, 2026-11-05: the toolkit, step by step). The family's MAUI apps use the same package. -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- The shared learning engine, from the local feed C:\nuget-local (..\LearningCore\build\pack.ps1). -->
    <PackageReference Include="Eaglin.Learning.Core" Version="1.4.0" />
    <PackageReference Include="Eaglin.Learning.Reports.Pdf" Version="1.4.0" />
    <!-- The AI, optional (Ron, 2026-11-15: "make the shell AI enabled (optional)"): the one AI layer every program uses,
         from the same local feed (..\AiManager\build\pack.ps1). Every release moves to the latest AI Manager (plan R.1). -->
    <PackageReference Include="Eaglin.AiManager" Version="1.9.0" />
    <PackageReference Include="Eaglin.AiManager.Wpf" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plc.Engine\Plc.Engine.csproj" />
    <ProjectReference Include="..\Plc.Dialects.Iec\Plc.Dialects.Iec.csproj" />
    <ProjectReference Include="..\Plc.Scenes\Plc.Scenes.csproj" />
    <ProjectReference Include="..\Plc.Grading\Plc.Grading.csproj" />
    <ProjectReference Include="..\Plc.Editors\Plc.Editors.csproj" />
  </ItemGroup>

</Project>
