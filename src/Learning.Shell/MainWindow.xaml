<Window x:Class="Learning.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC+ — preview for review" Width="1400" Height="900" MinWidth="1000" MinHeight="620"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="ApplicationCommands.Help" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Help" Executed="Help_Executed" />
    </Window.CommandBindings>

    <DockPanel KeyboardNavigation.TabNavigation="Local">
        <Menu DockPanel.Dock="Top" Padding="4,2" KeyboardNavigation.TabIndex="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open a program…" Click="OpenProgram_Click"
                          ToolTip="Opens a program saved from PLC+ (.plcprogram) as My program, to run and edit" />
                <MenuItem Header="_Save My program as…" Click="SaveProgram_Click"
                          ToolTip="Saves My program to a file you choose (.plcprogram), to keep, hand in or open on another computer" />
                <MenuItem Header="Save the program as a _picture…" Click="SavePicture_Click"
                          ToolTip="Saves the rungs shown on the left as a picture (PNG), for a report or a handout" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" ToolTip="Closes PLC+. My program is kept for each challenge." />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help for this screen" InputGestureText="F1" Command="ApplicationCommands.Help"
                          ToolTip="Shows or hides the help panel on the right: what this screen is for and how to use it" />
                <Separator />
                <MenuItem Header="_About PLC+…" Click="About_Click" ToolTip="Who made PLC+, its version, and where to find more" />
            </MenuItem>
        </Menu>

        <!-- Status line: always says what to do next. -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Help panel (F1). -->
        <Border x:Name="HelpPanel" DockPanel.Dock="Right" Width="290" KeyboardNavigation.TabIndex="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="How to use this screen" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}">
                        A preview of PLC+ for review. It has six simulated machines, each with a challenge, and for each one a program that works and a program with a common mistake.
                        Lessons, the ladder editor (to write your own programs) and saved progress come later.
                    </TextBlock>
                    <TextBlock Text="1. Choose a challenge" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Challenge (at the top) picks the machine and its task. Program picks the program the PLC runs: the one that works, or the one with a common mistake.
                    </TextBlock>
                    <TextBlock Text="2. Watch the program run" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        The rungs on the left run live. Power flows from the left rail to the right. A part that passes power is green and thick and shows TRUE; one that does not is grey and thin and shows FALSE.
                    </TextBlock>
                    <TextBlock Text="3. Work the machine" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Hold a push button down to press it (or Tab to it and hold the Space bar). Switches stay where you turn them. Each part says what it is doing in words; "What every part is doing" lists them all.
                        A Stop button is wired normally closed: its input is TRUE until you press it, so a broken wire stops the machine.
                    </TextBlock>
                    <TextBlock Text="4. Check the program" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        Check this program runs the challenge's tests — buttons pressed at set times, the machine watched — much faster than real time. A failed test says what should have happened, and when, and replays what did.
                    </TextBlock>
                    <TextBlock Text="The clock" FontWeight="SemiBold" Margin="0,6,0,2" />
                    <TextBlock Style="{StaticResource Lead}">
                        The PLC runs on a simulated clock: every scan moves it on by exactly 10 ms, so a program and a test always give the same result.
                        Pause stops the clock; Step one scan runs one scan; Reset starts again from power-up (your test results stay). To press a button while stepping, tick its "keep pressed" box.
                    </TextBlock>
                    <Button Content="Hide help" HorizontalAlignment="Left" Click="Help_Executed" Margin="0,8,0,0"
                            ToolTip="Hides this panel. Press F1 or use Help ▸ Help for this screen to show it again." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Margin="16,10,16,12" KeyboardNavigation.TabIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="330" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                <WrapPanel Margin="0,0,0,6">
                    <Label Content="Chall_enge:" Target="{Binding ElementName=ChallengePicker}" Padding="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="ChallengePicker" Width="330" SelectionChanged="ChallengePicker_SelectionChanged" Margin="0,0,20,0"
                              AutomationProperties.Name="Challenge"
                              ToolTip="Which machine and task. Choosing another one loads its machine, its programs and its tests." />
                    <Label Content="_Program:" Target="{Binding ElementName=ProgramPicker}" Padding="0,0,8,0" VerticalAlignment="Center" />
                    <ComboBox x:Name="ProgramPicker" Width="220" SelectionChanged="ProgramPicker_SelectionChanged"
                              AutomationProperties.Name="Program"
                              ToolTip="Which program the PLC runs: the one that works, one with a common mistake, or My program — yours to write and edit. Choosing another one resets the PLC and the machine." />
                </WrapPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="BriefText" Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}" />
            </StackPanel>

            <!-- The program -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="The program" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock DockPanel.Dock="Top" x:Name="ProgramNote" Style="{StaticResource Lead}" />

                    <!-- The ladder editor's tools: shown for My program (plan 3.1, 3.4). -->
                    <StackPanel DockPanel.Dock="Top" x:Name="EditorTools" Visibility="Collapsed" Margin="0,0,0,6">
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="7,3" />
                                    <Setter Property="Margin" Value="0,0,4,4" />
                                    <Setter Property="FontSize" Value="13" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button Content="-| |-  Contact" Tag="O" Click="Tool_Click" PreviewMouseLeftButtonDown="Tool_DragStart" PreviewMouseMove="Tool_DragMove"
                                    ToolTip="Adds a normally open contact after the selected element: it passes power while its tag is TRUE. Key: O. You can also drag it onto an element. Shift+O puts it before the selected element." />
                            <Button Content="-|/|-  Closed" Tag="C" Click="Tool_Click" PreviewMouseLeftButtonDown="Tool_DragStart" PreviewMouseMove="Tool_DragMove"
                                    ToolTip="Adds a normally closed contact: it passes power while its tag is FALSE. Key: C (Shift+C puts it before)" />
                            <Button Content="-|P|-" Tag="P" Click="Tool_Click" PreviewMouseLeftButtonDown="Tool_DragStart" PreviewMouseMove="Tool_DragMove"
                                    ToolTip="Adds a rising-edge contact: it passes power for one scan when its tag turns TRUE. Key: P" />
                            <Button Content="-|N|-" Tag="N" Click="Tool_Click" PreviewMouseLeftButtonDown="Tool_DragStart" PreviewMouseMove="Tool_DragMove"
                                    ToolTip="Adds a falling-edge contact: it passes power for one scan when its tag turns FALSE. Key: N" />
                            <Button Content="-( )-  Coil" Tag="Q" Click="Tool_Click" PreviewMouseLeftButtonDown="Tool_DragStart" PreviewMouseMove="Tool_DragMove"
                                    ToolTip="Adds a coil: its tag follows the power that reaches it. Key: Q. You can also drag the contact and coil tools onto an element." />
                            <Button Content="-(S)-" Tag="S" Click="Tool_Click" PreviewMouseLeftButtonDown="Tool_DragStart" PreviewMouseMove="Tool_DragMove"
                                    ToolTip="Adds a set (latch) coil: power turns its tag on, and it stays on. Key: S" />
                            <Button Content="-(R)-" Tag="R" Click="Tool_Click" PreviewMouseLeftButtonDown="Tool_DragStart" PreviewMouseMove="Tool_DragMove"
                                    ToolTip="Adds a reset (unlatch) coil: power turns its tag off. Key: R" />
                            <Button Content="Branch" Tag="B" Click="Tool_Click"
                                    ToolTip="Puts a parallel branch (OR) around the selected element, with a new contact on it. Select several with Shift+arrow first; with a whole branch selected, adds another path. Key: B" />
                            <Button x:Name="BoxButton" Content="Box ▾" Click="BoxButton_Click"
                                    ToolTip="Adds a timer, counter, compare, math or move box after the selected element. Key: I" />
                        </WrapPanel>
                        <WrapPanel>
                            <WrapPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="7,3" />
                                    <Setter Property="Margin" Value="0,0,4,4" />
                                    <Setter Property="FontSize" Value="13" />
                                </Style>
                            </WrapPanel.Resources>
                            <Button Content="New rung" Tag="NewRung" Click="Tool_Click" ToolTip="Adds a rung below the selected one, with a contact and a coil. Key: Ctrl+Enter" />
                            <Button Content="Delete" Tag="Delete" Click="Tool_Click" ToolTip="Deletes the selected element, or the rung if the rung is selected. Key: Delete" />
                            <Button Content="Rung ▲" Tag="Up" Click="Tool_Click" ToolTip="Moves the selected rung up. Rungs run top to bottom, so order matters. Key: Alt+Up" />
                            <Button Content="Rung ▼" Tag="Down" Click="Tool_Click" ToolTip="Moves the selected rung down. Key: Alt+Down" />
                            <Button x:Name="UndoButton" Content="Undo" Tag="Undo" Click="Tool_Click" ToolTip="Undoes the last change. Key: Ctrl+Z" />
                            <Button x:Name="RedoButton" Content="Redo" Tag="Redo" Click="Tool_Click" ToolTip="Puts back what Undo took away. Key: Ctrl+Y" />
                            <Button Content="Copy rung" Tag="Copy" Click="Tool_Click" ToolTip="Copies the selected rung. Key: Ctrl+C" />
                            <Button Content="Paste rung" Tag="Paste" Click="Tool_Click" ToolTip="Pastes a copied rung below the selected one. Key: Ctrl+V" />
                            <Button x:Name="StartAgainButton" Content="Start again ▾" Click="StartAgain_Click"
                                    ToolTip="Replaces My program with an empty program, or with a copy of the working program or of the mistake" />
                        </WrapPanel>
                        <Border Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="8,6" Margin="0,2,0,0">
                            <WrapPanel x:Name="PropertiesHost" />
                        </Border>
                    </StackPanel>

                    <Expander DockPanel.Dock="Bottom" x:Name="ProblemsExpander" Header="Problems" IsExpanded="True" Visibility="Collapsed" Margin="0,6,0,0"
                              ToolTip="What is wrong with the program, rung by rung. Choose one to go to it.">
                        <ListBox x:Name="ProblemsList" MaxHeight="84" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0" SelectionChanged="ProblemsList_SelectionChanged"
                                 AutomationProperties.Name="Problems in the program; choose one to select the element it is about">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>

                    <ScrollViewer x:Name="LadderScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                                  PreviewKeyDown="Ladder_KeyDown" AllowDrop="True" Drop="Ladder_Drop" DragOver="Ladder_DragOver"
                                  FocusVisualStyle="{x:Null}" BorderThickness="2" BorderBrush="Transparent"
                                  GotKeyboardFocus="Ladder_GotFocus" LostKeyboardFocus="Ladder_LostFocus">
                        <Canvas x:Name="LadderCanvas" AutomationProperties.Name="Ladder program, live" Background="Transparent" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- The machine -->
            <Border Grid.Row="1" Grid.Column="1" Width="545" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12">
                <DockPanel KeyboardNavigation.TabNavigation="Local">
                    <TextBlock DockPanel.Dock="Top" x:Name="SceneTitle" Style="{StaticResource PanelTitle}" AutomationProperties.HeadingLevel="Level2" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" KeyboardNavigation.TabIndex="0">
                        <WrapPanel DockPanel.Dock="Right">
                            <Button x:Name="PauseButton" Content="P_ause" Click="Pause_Click" Margin="0,0,6,0"
                                    ToolTip="Stops the simulated clock. The program and the machine stay as they are." />
                            <Button x:Name="StepButton" Content="Step one _scan" Click="Step_Click" Margin="0,0,6,0" IsEnabled="False"
                                    ToolTip="Runs exactly one scan (10 ms). Available while paused: press Pause first." />
                            <Button Content="_Reset" Click="Reset_Click" Margin="0"
                                    ToolTip="Starts again from power-up: every tag off, the machine as it began, the clock at 0. Your test results stay." />
                        </WrapPanel>
                        <TextBlock x:Name="ClockText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                    </DockPanel>
                    <Expander DockPanel.Dock="Bottom" Header="_The wiring: which tag is which" Margin="0,6,0,0" KeyboardNavigation.TabIndex="3"
                              ToolTip="Every input and output tag of this machine, and what it means">
                        <ItemsControl x:Name="WiringList" Margin="18,4,0,0" AutomationProperties.Name="The wiring">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander DockPanel.Dock="Bottom" Header="_What every part is doing" Margin="0,6,0,0" KeyboardNavigation.TabIndex="2"
                              ToolTip="Each part of the machine and its state, in words">
                        <ItemsControl x:Name="StateList" Margin="18,4,0,0" AutomationProperties.Name="What every part of the machine is doing">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False" KeyboardNavigation.TabIndex="1">
                        <Canvas x:Name="SceneCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- The grader -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="230" Margin="0,0,12,0">
                        <Button x:Name="CheckButton" Content="_Check this program" Click="Check_Click" HorizontalAlignment="Left"
                                ToolTip="Runs the challenge's tests on this program, from a clean start each time, and shows which pass" />
                        <TextBlock x:Name="ScoreText" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="True" MaxHeight="170" MinHeight="60" AutomationProperties.Name="Test results; use the arrow keys to scroll"
                                  ToolTip="The test results. Scroll to read them all (arrow keys or the mouse wheel)">
                        <ItemsControl x:Name="ResultsList" AutomationProperties.Name="Test results" MinHeight="60" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
