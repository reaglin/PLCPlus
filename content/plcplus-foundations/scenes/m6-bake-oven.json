    {
      "type": "selectorSwitch",
      "id": "bake",
      "label": "Bake",
      "tag": "BakeSW",
      "positions": [
        "Off",
        "On"
      ],
      "x": 30,
      "y": 30
    },
    {
      "type": "selectorSwitch",
      "id": "door",
      "label": "Oven door",
      "tag": "DoorShut",
      "positions": [
        "Open",
        "Shut"
      ],
      "on": true,
      "x": 30,
      "y": 130
    },
    {
      "type": "pushButton",
      "id": "clear",
      "label": "Clear",
      "tag": "ClearPB",
      "color": "green",
      "x": 30,
      "y": 230
    },
    {
      "type": "pilotLight",
      "id": "heater",
      "label": "Heater",
      "tag": "Heater",
      "color": "red",
      "x": 260,
      "y": 60
    },
    {
      "type": "pilotLight",
      "id": "done",
      "label": "Done",
      "tag": "DoneLight",
      "color": "green",
      "x": 260,
      "y": 200
    }
  ]
}
