        {
          "t": 1.1,
          "operate": "part",
          "active": true
        },
        {
          "t": 1.2,
          "operate": "part",
          "active": false
        },
        {
          "t": 1.5,
          "operate": "reset",
          "active": true
        },
        {
          "t": 1.6,
          "operate": "reset",
          "active": false
        }
      ],
      "assertions": [
        {
          "at": 1.35,
          "tag": "BatchDone",
          "expect": "TRUE",
          "says": "A 6th part in a batch of 5 is one too many, but the batch is still done: Batch done should stay lit (the count is 6, which is at least 5)."
        },
        {
          "at": 1.8,
          "tag": "BatchDone",
          "expect": "FALSE",
          "says": "Reset sets the count back to 0, so Batch done should go out."
        },
        {
          "at": 1.8,
          "tag": "Filling",
          "expect": "FALSE",
          "says": "After Reset the box is empty, so Filling batch should be off."
        }
      ]
    },
    {
      "name": "The batch size comes from the thumbwheel",
      "points": 1,
      "durationSeconds": 1.0,
      "events": [
        {
          "t": 0,
          "operate": "batch",
          "value": 3
