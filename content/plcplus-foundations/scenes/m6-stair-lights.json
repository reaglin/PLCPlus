{
  "schemaVersion": 1,
  "id": "m6-stair-lights",
  "title": "Stairwell and porch lights",
  "description": "A stairwell light with a button at the top and at the bottom of the stairs, and a porch light that follows the front door. The stair light stays on for a fixed time per press; the porch light stays on for a while after the door shuts.",
