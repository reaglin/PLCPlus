            ]
          }
        },
        {
          "comment": "The horn follows the switch too, so the alarm clears itself when the oven cools.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "Overheat",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
