<Window x:Class="Learning.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PLC+" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="PLC+" Style="{StaticResource SectionTitle}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10" />
        <TextBlock Style="{StaticResource Lead}" Foreground="{DynamicResource InkBrush}"
                   Text="Learn PLC programming at home, from electrical basics to advanced ladder logic, with simulated machines in place of real hardware. Everything works offline, and your progress stays on this computer until you choose to hand in a report." />

        <!-- Created by (portfolio rule, 2026-09-25) -->
        <DockPanel Margin="0,8,0,14">
            <Border DockPanel.Dock="Left" Width="96" Height="96" CornerRadius="12" Margin="0,0,16,0" AutomationProperties.Name="Photo of Dr. Ron Eaglin">
                <Border.Background>
                    <ImageBrush ImageSource="Images/dr-ron-eaglin.jpg" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Created by Dr. Ron Eaglin" FontSize="17" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Simulations that prepare students for the PLC lab." />
            </StackPanel>
        </DockPanel>

        <!-- Links (portfolio rules, plan 12.6): the program's page, the Store page and all the programs. The Store line shows once
             StoreUpdates.StorePage has the Store ID from Partner Center. -->
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
            More about PLC+, with help and examples:
            <Hyperlink ToolTip="Opens PLC+&#x27;s page on softwareplus.ai in your web browser" NavigateUri="https://softwareplus.ai/plcplus/" RequestNavigate="Link_RequestNavigate">softwareplus.ai/plcplus</Hyperlink>
        </TextBlock>
        <TextBlock x:Name="StoreLine" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed">
            PLC+ on the Microsoft Store (updates, ratings and reviews):
            <Hyperlink x:Name="StoreLink" ToolTip="Opens PLC+&#x27;s page on the Microsoft Store in your web browser" RequestNavigate="Link_RequestNavigate"><Run x:Name="StoreLinkText" /></Hyperlink>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
            Reviewing PLC+? The testing guide, and how to send your notes:
            <Hyperlink ToolTip="Opens the instructors&#x27; testing guide on softwareplus.ai in your web browser" NavigateUri="https://softwareplus.ai/plcplus/testing/" RequestNavigate="Link_RequestNavigate">softwareplus.ai/plcplus/testing</Hyperlink>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
            Privacy policy (your progress stays on this computer; PLC+ sends it nowhere):
            <Hyperlink ToolTip="Opens PLC+&#x27;s privacy policy on softwareplus.ai in your web browser" NavigateUri="https://softwareplus.ai/plcplus/privacy/" RequestNavigate="Link_RequestNavigate">softwareplus.ai/plcplus/privacy</Hyperlink>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
            All of Dr. Ron Eaglin's programs:
            <Hyperlink ToolTip="Opens the list of all Dr. Ron Eaglin&#x27;s programs on softwareplus.ai" NavigateUri="https://softwareplus.ai/#programs" RequestNavigate="Link_RequestNavigate">softwareplus.ai</Hyperlink>
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource MutedTextBrush}"
                   Text="Published on the Microsoft Store by Dean Eaglin. Free." />

        <Button ToolTip="Closes this window (Esc or Enter)" Content="_Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Margin="0" Click="Close_Click" />
    </StackPanel>
</Window>
