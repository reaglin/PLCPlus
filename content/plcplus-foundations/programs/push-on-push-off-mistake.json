{
  "schemaVersion": 1,
  "name": "One button: push on, push off (a common mistake)",
  "dialect": "iec61131-3",
  "scanTimeMs": 10,
  "tags": [
    {
      "name": "LightPB",
      "type": "BOOL",
      "io": "input",
      "comment": "Light button: TRUE while pressed"
    },
    {
      "name": "WorkLight",
      "type": "BOOL",
      "io": "output"
    },
    {
      "name": "Pulse",
      "type": "BOOL",
      "comment": "TRUE for one scan when the button is pressed"
    }
  ],
  "programs": [
    {
      "name": "Main",
      "rungs": [
        {
          "comment": "MISTAKE: a normally open contact, not a rising edge, so Pulse is TRUE for every scan the button is held.",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "contact",
                "tag": "LightPB",
                "contact": "normallyOpen"
              },
              {
                "kind": "coil",
                "tag": "Pulse",
                "coil": "normal"
              }
            ]
          }
        },
        {
          "comment": "Toggle: on if (Pulse AND it was off) OR (NOT Pulse AND it was on).",
          "logic": {
            "kind": "series",
            "items": [
              {
                "kind": "parallel",
                "branches": [
                  {
                    "kind": "series",
                    "items": [
                      {
                        "kind": "contact",
                        "tag": "Pulse",
                        "contact": "normallyOpen"
                      },
                      {
                        "kind": "contact",
                        "tag": "WorkLight",
                        "contact": "normallyClosed"
                      }
                    ]
                  },
                  {
                    "kind": "series",
                    "items": [
                      {
                        "kind": "contact",
                        "tag": "Pulse",
                        "contact": "normallyClosed"
                      },
                      {
                        "kind": "contact",
                        "tag": "WorkLight",
                        "contact": "normallyOpen"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "coil",
                "tag": "WorkLight",
                "coil": "normal"
              }
            ]
          }
        }
      ]
    }
  ]
}
